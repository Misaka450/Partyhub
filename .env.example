# =========================================================================
# 🎮 PartyHub 环境变量配置示例模板
# 复制本文件为 .env 并填写实际值：
#   cp .env.example .env
# 注意：.env 文件已被 .gitignore 忽略，切勿将其提交到公共版本库！
# =========================================================================

# HTTP 端口
PORT=8080

# 跨域域名白名单，多个用逗号隔开；允许所有来源设为 *
CORS_ORIGIN=*

# WebRTC Coturn 语音中继服务器配置
# 生产环境中请替换为您自己的服务器 IP 及复杂秘钥
TURN_URL=turn:127.0.0.1:3478
TURN_USERNAME=partyhub
TURN_CREDENTIAL=your_secure_password_here
