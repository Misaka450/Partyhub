# =========================================================================
# 🎮 PartyHub 环境变量配置示例模板
# 复制本文件为 .env 并填写实际值：
#   cp .env.example .env
# 注意：.env 文件已被 .gitignore 忽略，切勿将其提交到公共版本库！
# =========================================================================

# HTTP 端口
PORT=8080

# 跨域域名白名单，多个用逗号隔开；允许所有来源设为 *
# 部署到固定域名后请收紧为具体域名，如 https://party.example.com
CORS_ORIGIN=*

# =========================================================================
# WebRTC Coturn 语音中继服务器配置（可选）
# -------------------------------------------------------------------------
# 不配置任何 TURN_* 变量时，语音自动降级为纯 STUN 直连（大多数家庭/办公
# 网络可用）；仅在复杂 NAT（手机 4G/5G、对称 NAT）下通话失败才需要中继。
#
# 启用中继（docker-compose 中 coturn 为 profile 可选服务）：
#   1. 在 .env 中填写下面 4 个变量（口令务必为强随机值，公网监听无弱口令可撞）
#   2. 启动：docker compose --profile turn up -d
#   3. 服务器防火墙需放行 3478/tcp+udp 与 49152-49200/udp
#
# 推荐使用 TURN_SECRET（REST API 短效凭据，1 小时自动轮换）而非静态口令；
# 配置了 TURN_SECRET 时服务端会为每位玩家签发独立的 HMAC 短效凭据。
# =========================================================================
# TURN_URL=turn:你的服务器公网IP:3478
# COTURN_EXTERNAL_IP=你的服务器公网IP
# TURN_USERNAME=partyhub
# TURN_CREDENTIAL=请替换为强随机口令（openssl rand -base64 24）
# TURN_SECRET=请替换为强随机密钥（openssl rand -hex 32，与 coturn 的 static-auth-secret 一致）
